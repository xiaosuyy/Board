<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebDAV / SyncClipboard 同步需要网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 语音输入：只交给系统 SpeechRecognizer，Board 自身不录音、不上传 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".BoardApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Board"
        android:usesCleartextTraffic="true">
        <!--
          明文 HTTP：**默认拒绝**，且全 App 只在 WebDAV 客户端一处可能放行。
          Android 的 network-security-config 无法为用户**动态填写**的地址、也无法按 RFC1918
          网段做例外（不支持 CIDR），因此这里保留平台开关，改由代码强制判定
          （WebDavUrlPolicy，发起请求前拦截）：
            · https:// 一律放行；
            · http:// 必须用户在设置里显式开启「允许未加密 HTTP」，
              且地址解析结果必须全部是本机 / 回环 / link-local / RFC1918 私网 / IPv6 ULA；
            · 公网 HTTP 一律拒绝。
          除 WebDAV 之外，不允许出现任何明文 HTTP。
        -->

        <!-- 设置页：用于启用输入法、切换输入法、试用键盘 -->
        <activity
            android:name=".settings.BoardSettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 只用于代弹麦克风授权弹窗：无界面、不留在最近任务 -->
        <activity
            android:name=".ime.MicPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 常用语新增 / 编辑：极简编辑页（输入法无法给自己输入文字，所以用 Activity） -->
        <activity
            android:name=".phrase.PhraseEditActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="常用语"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".settings.DictionaryActivity"
            android:exported="false"
            android:label="@string/dictionary_title" />

        <!--
          「分享给 Board」：其它 App 分享 text/plain（文本）或 image/*（图片）时，
          都可以直接存进 Board 剪贴板 / 图片剪贴板。
          优先用 content:// URI（大文本 / 图片不必经过 Intent 字符串），见 ClipboardShareActivity。
          Phase 1-E：图片分享是「输入适配层」，最终汇合到与系统剪贴板图片同一条链路。
        -->
        <activity
            android:name=".clipboard.ClipboardShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:noHistory="true"
            android:theme="@style/Theme.Board">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
          FileProvider：只服务于 Android 图片剪贴板 URI（系统剪贴板放不下原始图片字节，
          只能放一个可解析的 content:// URI）。
          · exported=false、grantUriPermissions=true
          · 只开放 <files>/clipboard-images/（见 res/xml/board_file_paths.xml）
          · **不**暴露整个 App 私有目录
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/board_file_paths" />
        </provider>

        <activity
            android:name=".settings.SettingsSectionActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- 输入法服务：声明 android.view.InputMethod 后才会出现在系统输入法列表中 -->
        <service
            android:name=".ime.BoardInputMethodService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:theme="@style/Theme.Board.Ime">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/board_ime_method" />
        </service>
    </application>

</manifest>
